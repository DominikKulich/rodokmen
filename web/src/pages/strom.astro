---
import Base from '../layouts/Base.astro';
import StromIlustrace from '../components/StromIlustrace.astro';
---
<Base title="Strom" wide>
  <div class="strom-print">
  <h1>Strom předků</h1>
  <p class="lead">Kmen je Dominik, každá větev vede k rodičům. Kliknutím na stuhu otevřete kartu osoby, poupata na koncích větví jsou předci, které teprve hledáme.</p>
  <div class="print-bar no-print"><button type="button" class="btn" onclick="window.print()">🖨 Vytisknout strom (A3 na šířku) / PDF</button></div>
  <StromIlustrace />
  </div>
</Base>
