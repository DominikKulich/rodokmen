---
import Base from '../layouts/Base.astro';
import PersonLink from '../components/PersonLink.astro';
import { people, byK, places, genName, href } from '../lib/data.js';

const anc = Object.values(people).filter((p) => p.k > 1);
const maxG = Math.max(...anc.map((p) => p.gen));
// úplnost po generacích
const gens = Array.from({ length: maxG }, (_, i) => i + 1).map((g) => {
  const ks = Object.keys(byK).map(Number).filter((k) => k >= 2 ** g && k < 2 ** (g + 1));
  const ps = [...new Set(ks.map((k) => byK[k]?.slug))].map((s) => people[s]).filter(Boolean);
  return { g, max: 2 ** g, n: ps.length, doc: ps.filter((p) => p.st === 'doc').length };
});
// datum z faktu
const parse = (f) => { const m = f.match(/(?:(\d{1,2})\.\s*(\d{1,2})\.\s*)?(\d{4})/); return m ? { y: +m[3], m: +(m[2] || 0), d: +(m[1] || 0), exact: !!m[1] } : null; };
const ev = (p, sym) => { const f = (p.facts || []).find((x) => x.trim().startsWith(sym)); return f ? { ...parse(f), asi: /asi/.test(f) } : null; };
const age = (a, b) => b.y - a.y - (a.exact && b.exact && (b.m < a.m || (b.m === a.m && b.d < a.d)) ? 1 : 0);
const lives = anc.map((p) => ({ p, b: ev(p, '*'), d: ev(p, '†') })).filter((x) => x.b?.y && x.d?.y).map((x) => ({ ...x, age: age(x.b, x.d), asi: x.b.asi || x.d.asi }));
const marr = anc.map((p) => ({ p, b: ev(p, '*'), w: ev(p, '×') })).filter((x) => x.b?.y && x.w?.y).map((x) => ({ ...x, age: age(x.b, x.w), asi: x.b.asi }));
// povolání
const JOBS = ['zahradník', 'domkář', 'podruh', 'řezník', 'zedník', 'učitel', 'švadlena', 'služka', 'familiant', 'výměnkář'];
const jobs = JOBS.map((j) => ({ j, ps: anc.filter((p) => (p.facts || []).some((f) => f.toLowerCase().includes(j.slice(0, -1)))) })).filter((x) => x.ps.length).sort((a, b) => b.ps.length - a.ps.length);
// křestní jména
const first = {};
for (const p of anc) { const n = p.name.split(' ')[0]; (first[n] ??= []).push(p); }
const names = Object.entries(first).filter(([, v]) => v.length > 1).sort((a, b) => b[1].length - a[1].length);
const topPlaces = places.map((pl) => ({ pl, n: new Set(pl.lines.flatMap((l) => l.people)).size })).sort((a, b) => b.n - a.n).slice(0, 8);
const pct = (a, b) => Math.round((100 * a) / b);
const maxPl = topPlaces[0]?.n || 1;
---
<Base title="Statistiky">
  <h1>Rod v číslech</h1>
  <p class="lead">Co se dá vyčíst z dosud dohledaných předků. Čísla porostou s každým nalezeným zápisem.</p>

  <div class="kpis">
    <div class="card"><b>{anc.length}</b><span>známých předků</span></div>
    <div class="card"><b>{anc.filter((p) => p.st === 'doc').length}</b><span>doloženo matrikou</span></div>
    <div class="card"><b>{maxG + 1}</b><span>generací</span></div>
    <div class="card"><b>{places.length}</b><span>obcí</span></div>
  </div>

  <h2>Jak úplný je strom</h2>
  <p class="small muted">Každý má 2 rodiče, 4 prarodiče, 8 praprarodičů… Tmavá část = doloženo matrikou, světlá = údaj od rodiny nebo pravděpodobné.</p>
  <div class="bars">
    {gens.map((g) => (
      <div class="bar-row">
        <span class="bar-lbl">{genName(g.g)}</span>
        <span class="bar"><span class="bar-all" style={`width:${pct(g.n, g.max)}%`}></span><span class="bar-doc" style={`width:${pct(g.doc, g.max)}%`}></span></span>
        <span class="bar-num">{g.n} / {g.max}</span>
      </div>
    ))}
  </div>

  <div class="grid2">
    <div>
      <h2>Věk při sňatku</h2>
      <ul class="facts">{marr.sort((a, b) => a.w.y - b.w.y).map((x) => <li><PersonLink slug={x.p.slug} showYears={false} /> – {x.asi ? 'asi ' : ''}{x.age} let <span class="small muted">({x.w.y})</span></li>)}</ul>
      {marr.length > 0 && <p class="small muted">Průměr {Math.round(marr.reduce((s, x) => s + x.age, 0) / marr.length)} let.</p>}
    </div>
    <div>
      <h2>Délka života</h2>
      <ul class="facts">{lives.sort((a, b) => b.age - a.age).map((x) => <li><PersonLink slug={x.p.slug} showYears={false} /> – {x.asi ? 'asi ' : ''}{x.age} let</li>)}</ul>
    </div>
  </div>

  <div class="grid2">
    <div>
      <h2>Povolání</h2>
      <ul class="facts">{jobs.map((x) => <li><b>{x.j}</b> – {x.ps.map((p, i) => <>{i > 0 && ', '}<a href={href.person(p.slug)}>{p.name}</a></>)}</li>)}</ul>
    </div>
    <div>
      <h2>Opakující se jména</h2>
      <ul class="facts">{names.map(([n, ps]) => <li><b>{n}</b> ×{ps.length} <span class="small muted">({ps.map((p) => p.years || `${p.gen}. gen.`).join(', ')})</span></li>)}</ul>
    </div>
  </div>

  <h2>Nejvíc předků</h2>
  <div class="bars">
    {topPlaces.map(({ pl, n }) => (
      <div class="bar-row"><a class="bar-lbl" href={href.place(pl.name)}>{pl.name}</a><span class="bar"><span class="bar-all bar-pl" style={`width:${pct(n, maxPl)}%`}></span></span><span class="bar-num">{n}</span></div>
    ))}
  </div>
</Base>
<style>
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .7rem; margin: 1rem 0; }
  .kpis .card { display: flex; flex-direction: column; }
  .kpis b { font: 2.2rem var(--serif); color: var(--accent); }
  .kpis span { color: var(--muted); font-size: .9rem; }
  .bars { display: grid; gap: .45rem; margin: .5rem 0 1rem; }
  .bar-row { display: grid; grid-template-columns: minmax(8rem, 15rem) 1fr 4.5rem; gap: .7rem; align-items: center; font-size: .92rem; }
  .bar { position: relative; height: 1.1rem; background: #efe9de; border-radius: 4px; overflow: hidden; }
  .bar span { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 4px; }
  .bar-all { background: #e2c58f; }
  .bar-doc { background: var(--doc); }
  .bar-pl { background: var(--accent); }
  .bar-num { color: var(--muted); font-variant-numeric: tabular-nums; }
  @media (max-width: 560px) { .bar-row { grid-template-columns: 7rem 1fr 3.5rem; font-size: .82rem; } }
</style>
