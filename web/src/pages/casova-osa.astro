---
import Base from '../layouts/Base.astro';
import { people, lineByK, records, href, statusClass, places, placesIn, placeSlug } from '../lib/data.js';

// Události z faktů osob: „* …“ narození, „× …“ sňatek, „† …“ úmrtí.
const KIND = { '*': { n: 'narození', i: '✶' }, '×': { n: 'sňatek', i: '⚭' }, '†': { n: 'úmrtí', i: '✝' } };
const dateRe = /^(asi\s+)?(?:(\d{1,2})\.\s*(\d{1,2})\.\s*)?(\d{4})\s*(.*)$/;
const events = [];
const seen = new Set();
for (const p of Object.values(people)) {
  for (const f of p.facts || []) {
    const sym = f.trim()[0];
    if (!KIND[sym]) continue;
    const m = f.trim().slice(1).trim().match(dateRe);
    if (!m) continue;
    const [, asi, d, mo, y, rest] = m;
    const year = Number(y);
    let place = rest.replace(/\s*\(\?\)\s*/g, ' (?) ').trim();
    let partner = null;
    if (sym === '×') {
      // „Strážisko Františka Krejčí“ – partner je ten druhý z páru, najdi ho mezi osobami
      const other = Object.values(people).find((o) => o.slug !== p.slug && place.includes(o.name.replace(/\s*\(\?\)/, '')));
      if (other) { partner = other; place = place.replace(other.name, '').trim(); }
      const key = [year, mo, d, ...[p.slug, partner?.slug].sort()].join('|');
      if (seen.has(key)) continue;
      seen.add(key);
    }
    place = place.replace(/\(2\. sňatek, vdovec\)/, '').replace(/^\s*[,–-]\s*/, '').trim();
    events.push({
      year, sort: year * 10000 + Number(mo || 0) * 100 + Number(d || 0),
      date: d ? `${d}. ${mo}. ${y}` : (asi ? `asi ${y}` : y),
      kind: sym, p, partner, place,
      line: p.line ?? partner?.line ?? null,
      rec: (p.records || []).find((k) => records[k]),
    });
  }
}
// Dějinné mezníky pro kontext
const history = [
  [1848, 'Zrušení roboty – poddaní se stávají svobodnými rolníky'],
  [1866, 'Prusko-rakouská válka, epidemie cholery na Moravě'],
  [1914, 'Začátek první světové války'],
  [1918, 'Vznik Československa'],
  [1938, 'Mnichovská dohoda, zábor pohraničí'],
  [1945, 'Konec druhé světové války, odsun Němců'],
  [1948, 'Únorový převrat'],
  [1968, 'Pražské jaro a srpnová okupace'],
  [1989, 'Sametová revoluce'],
  [1993, 'Vznik samostatné České republiky'],
];
const minY = Math.min(...events.map((e) => e.year)) - 5;
const all = [
  ...events,
  ...history.filter(([y]) => y >= minY).map(([year, text]) => ({ year, sort: year * 10000, hist: true, text })),
].sort((a, b) => a.sort - b.sort || (a.hist ? -1 : 1));
const usedPlaces = places.map((pl) => pl.name).filter((n) => events.some((e) => placesIn(e.place).includes(n))).sort((a, b) => a.localeCompare(b, 'cs'));
const usedLines = [...new Set(events.map((e) => e.line).filter(Boolean))].map((k) => lineByK[k]).filter(Boolean);
let lastDecade = null;
const rows = all.map((e) => {
  const dec = Math.floor(e.year / 10) * 10;
  const head = dec !== lastDecade ? dec : null;
  lastDecade = dec;
  return { ...e, head };
});
---
<Base title="Časová osa">
  <h1>Časová osa</h1>
  <p class="lead">Narození, svatby a úmrtí předků v čase – od nejstaršího doloženého data po dnešek. Šedě jsou pro souvislost velké dějinné události. Kliknutím na jméno se dostanete na kartu osoby, ikonou 📜 na původní zápis z matriky.</p>

  <div class="to-filter" role="group" aria-label="Filtr podle rodu">
    <button type="button" class="to-chip active" data-line="all">Všechny rody</button>
    {usedLines.map((l) => <button type="button" class="to-chip" data-line={String(l.k)} style={`--c:${l.color}`}><span class="to-dot"></span>{l.name}</button>)}
    <select id="to-place" class="to-select" aria-label="Obec"><option value="">všechny obce</option>{usedPlaces.map((n) => <option value={n}>{n}</option>)}</select>
    <label class="to-hist"><input type="checkbox" checked id="to-hist" /> dějinné události</label>
  </div>

  <ol class="timeline">
    {rows.map((e) => (
      <>
        {e.head !== null && <li class="to-decade"><span>{e.head}. léta</span></li>}
        {e.hist ? (
          <li class="to-item to-histrow" data-hist="1">
            <div class="to-year">{e.year}</div>
            <div class="to-mark to-mark-hist"></div>
            <div class="to-body"><span class="to-histtext">{e.text}</span></div>
          </li>
        ) : (
          <li class="to-item" data-line={e.line ? String(e.line) : 'none'} data-places={placesIn(e.place).join('|')} style={`--c:${e.line && lineByK[e.line] ? lineByK[e.line].color : 'var(--accent)'}`}>
            <div class="to-year">{e.date}</div>
            <div class="to-mark" title={KIND[e.kind].n}>{KIND[e.kind].i}</div>
            <div class="to-body">
              <div class="to-title">
                <span class="to-kind">{KIND[e.kind].n}</span>{' '}
                <a href={href.person(e.p.slug)}>{e.p.name}</a>
                {e.partner && <> a <a href={href.person(e.partner.slug)}>{e.partner.name}</a></>}
                {e.rec && <a class="to-rec" href={href.record(e.rec)} title="Zápis v matrice">📜</a>}
              </div>
              {e.place && <div class="to-place small muted">{e.place}{placesIn(e.place).slice(0, 1).map((n) => <> · <a href={href.place(n)}>o obci</a></>)}</div>}
              <div class="small"><span class={`chip ${statusClass(e.p.st)}`}>{e.p.status}</span>{e.line && lineByK[e.line] && <span class="muted"> · {lineByK[e.line].name}</span>}</div>
            </div>
          </li>
        )}
      </>
    ))}
  </ol>

  <p class="small muted">Rok bez přesného data znamená údaj od rodiny nebo odhad. Žijící lidé jsou uvedeni jen rokem narození.</p>

  <script>
    const chips = document.querySelectorAll<HTMLButtonElement>('.to-chip');
    const items = document.querySelectorAll<HTMLElement>('.to-item');
    const hist = document.getElementById('to-hist') as HTMLInputElement;
    const sel = document.getElementById('to-place') as HTMLSelectElement;
    let cur = 'all';
    function apply() {
      items.forEach((li) => {
        if (li.dataset.hist) { li.hidden = !hist.checked; return; }
        if (li.dataset.hist) return;
        li.hidden = (cur !== 'all' && li.dataset.line !== cur) || (!!sel.value && !(li.dataset.places || '').split('|').includes(sel.value));
      });
      document.querySelectorAll<HTMLElement>('.to-decade').forEach((d) => {
        let n = d.nextElementSibling as HTMLElement | null, any = false;
        while (n && !n.classList.contains('to-decade')) { if (!n.hidden) any = true; n = n.nextElementSibling as HTMLElement | null; }
        d.hidden = !any;
      });
    }
    chips.forEach((c) => c.addEventListener('click', () => {
      cur = c.dataset.line!;
      chips.forEach((x) => x.classList.toggle('active', x === c));
      apply();
    }));
    hist.addEventListener('change', apply);
    sel.addEventListener('change', apply);
  </script>
</Base>

<style>
  .to-filter { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; margin: 1rem 0 1.5rem; }
  .to-chip { border: 1px solid var(--line); background: var(--paper); border-radius: 999px; padding: .3rem .8rem; font: inherit; font-size: .9rem; cursor: pointer; color: var(--ink); display: inline-flex; align-items: center; gap: .35rem; }
  .to-chip.active { background: var(--accent-soft); border-color: var(--accent); }
  .to-dot { width: .6rem; height: .6rem; border-radius: 50%; background: var(--c); display: inline-block; }
  .to-select { font: inherit; font-size: .9rem; padding: .3rem .6rem; border: 1px solid var(--line); border-radius: 999px; background: var(--paper); }
  .to-hist { font-size: .9rem; color: var(--muted); margin-left: .5rem; }
  .timeline { list-style: none; padding: 0; margin: 0; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 8.4rem; top: 0; bottom: 0; width: 2px; background: var(--line); }
  .to-decade { margin: 1.4rem 0 .5rem; padding-left: 9.6rem; }
  .to-decade span { font-family: var(--serif); font-size: 1.15rem; color: var(--accent); }
  .to-item { display: grid; grid-template-columns: 7.6rem 1.6rem 1fr; gap: 0 .6rem; align-items: start; padding: .45rem 0; }
  .to-year { text-align: right; font-variant-numeric: tabular-nums; color: var(--muted); font-size: .92rem; padding-top: .35rem; }
  .to-mark { width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--paper); border: 2px solid var(--c); color: var(--c); display: grid; place-items: center; font-size: .85rem; position: relative; z-index: 1; }
  .to-mark-hist { width: .7rem; height: .7rem; border: 0; background: var(--unk); margin: .45rem auto 0; }
  .to-body { background: var(--paper); border: 1px solid var(--line); border-left: 4px solid var(--c); border-radius: var(--radius); padding: .5rem .8rem; }
  .to-histrow .to-body { background: transparent; border: 0; padding: .2rem 0; }
  .to-histtext { color: var(--muted); font-style: italic; font-size: .92rem; }
  .to-kind { text-transform: uppercase; letter-spacing: .04em; font-size: .72rem; color: var(--muted); }
  .to-title a { font-weight: 600; }
  .to-rec { text-decoration: none; margin-left: .3rem; font-weight: normal !important; }
  .to-place { margin: .1rem 0 .25rem; }
  @media (max-width: 640px) {
    .timeline::before { left: 4.9rem; }
    .to-item { grid-template-columns: 4.2rem 1.6rem 1fr; gap: 0 .4rem; }
    .to-year { font-size: .8rem; }
    .to-decade { padding-left: 6.1rem; }
  }
</style>
