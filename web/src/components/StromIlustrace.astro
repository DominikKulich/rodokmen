
---
import { byK, href, config } from '../lib/data.js';
const nodes = [];
function branch(k, g = 0) {
  const p = byK[k];
  const n = { k, g, p, children: [], x: 0, y: 0, span: 1 };
  nodes.push(n);
  if (p && g < 10) {
    n.children = [branch(k * 2, g + 1), branch(k * 2 + 1, g + 1)];
    n.span = n.children.reduce((s, c) => s + c.span, 0);
  }
  return n;
}
const root = branch(1);
const W = Math.max(1600, root.span * 182 + 160);
const H = Math.max(...nodes.map(n => n.g)) * 190 + 360;
function place(n, left) {
  n.x = left + n.span * 91;
  n.y = H - 200 - n.g * 190;
  let next = left;
  for (const c of n.children) { place(c, next); next += c.span * 182; }
}
place(root, (W - root.span * 182) / 2);
const initials = (name) => name.replace(/\(.*?\)/g, '').trim().split(/\s+/).slice(0, 2).map(s => s[0]).join('');
const status = { doc: 'Osoba doložena zápisem', fam: 'Údaj od rodiny', prob: 'Pravděpodobné' };
const missing = n => byK[Math.floor(n.k/2)]?.[n.k % 2 ? 'motherUnknown' : 'fatherUnknown'] ? 'v zápisu neuvedeno' : 'dosud hledáme';
---
<div class="tapestry" data-tree>
  <div class="tree-tools no-print" role="group" aria-label="Velikost stromu">
    <span>Rodová tapisérie</span>
    <div><button type="button" data-zoom="out" aria-label="Oddálit">−</button><button type="button" data-zoom="fit">Celý strom</button><button type="button" data-zoom="in" aria-label="Přiblížit">+</button></div>
  </div>
  <div class="strom-wrap" tabindex="0" role="region" aria-label="Posuvný rodový strom">
    <svg class="strom" viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" aria-label={`Rodový strom – ${config.nazev}`}>
      <defs>
        <pattern id="weave" width="8" height="8" patternUnits="userSpaceOnUse"><path d="M0 0H8M0 4H8M0 0V8M4 0V8" stroke="#c8b681" stroke-opacity=".035"/></pattern>
        <radialGradient id="cloth"><stop stop-color="#24332e"/><stop offset="1" stop-color="#101c19"/></radialGradient>
        <path id="leaf" d="M0 0Q-14-24 0-36Q14-24 0 0ZM0 0V-29" fill="#7e8157" stroke="#b6a36e" stroke-width=".7"/>
      </defs>
      <rect width={W} height={H} fill="url(#cloth)"/><rect width={W} height={H} fill="url(#weave)"/>
      <rect x="24" y="24" width={W-48} height={H-48} fill="none" stroke="#9d8657" stroke-width="2"/>
      <rect x="33" y="33" width={W-66} height={H-66} fill="none" stroke="#9d8657" stroke-opacity=".4"/>
      {[48, W-48].map(x => [48, H-48].map(y => <path d={`M${x-12} ${y}h24M${x} ${y-12}v24`} stroke="#c6ad77"/>))}
      <text x={W/2} y="88" text-anchor="middle" class="tree-caption">KOŘENY A PAMĚŤ NAŠÍ RODINY</text>
      {nodes.flatMap(n => n.children.map(c => <g>
        <path d={`M${n.x} ${n.y-58} C${n.x} ${n.y-118} ${c.x} ${c.y+100} ${c.x} ${c.y+42}`} fill="none" stroke="#ac9567" stroke-width={Math.max(1.4, 4-n.g*.4)} stroke-dasharray={c.p?.parentLink === 'prob' ? '8 7' : undefined}/>
        <use href="#leaf" transform={`translate(${c.x},${c.y+82}) rotate(40) scale(.7)`}/><use href="#leaf" transform={`translate(${c.x},${c.y+96}) rotate(-45) scale(.65)`}/>
      </g>))}
      {nodes.map(n => n.p ? <a href={href.person(n.p.slug)} class={`ancestor ${n.p.st}`}>
        <title>{n.p.name} · {status[n.p.st] || 'Neověřeno'}{n.p.parentLink === 'prob' ? ' · Vazba k dítěti nepotvrzena' : ''}</title>
        <g transform={`translate(${n.x},${n.y})`}>
          <path class="nameplate" d="M-82-18Q-86-25-78-30H-28Q0-42 28-30H78Q86-25 82-18V32H-82Z" fill="#17251f" stroke="#a38d5c"/>
          <ellipse cy="-57" rx="23" ry="29" fill="#17251f" stroke="#bfa674"/><ellipse cy="-57" rx="18" ry="24" fill="none" stroke="#a38d5c" stroke-opacity=".45"/>
          <text y="-51" text-anchor="middle" class="initials">{initials(n.p.name)}</text>
          <text y="-7" text-anchor="middle" class="person-name">{n.p.name.split(' ')[0]}</text>
          <text y="12" text-anchor="middle" class="person-name">{n.p.name.split(' ').slice(1).join(' ')}</text>
          <text y="50" text-anchor="middle" class="person-years">{n.p.years || 'data dosud neznámá'}</text>
          {n.p.st === 'doc' && <circle cx="79" cy="-29" r="5" fill="#d2be88"/>}
        </g>
      </a> : <a href="/hledame/"><title>{missing(n)}</title><path d={`M${n.x} ${n.y-12}l10 16-10 16-10-16Z`} fill="none" stroke="#8c805f"/><text x={n.x} y={n.y+40} text-anchor="middle" class="missing-text">{missing(n)}</text></a>)}
      <path d={`M${root.x} ${root.y+65}v42m0-22q-35 33-90 33m90-33q35 33 90 33`} fill="none" stroke="#b39c69" stroke-width="2"/>
      <text x={W/2} y={H-65} text-anchor="middle" class="tree-caption">KAŽDÉ JMÉNO MÁ SVŮJ PŘÍBĚH</text>
    </svg>
  </div>
</div>
<p class="strom-legend">Zlatý bod: osoba zachycená v matrice · Přerušovaná větev: nepotvrzené příbuzenství · Kurzíva: pravděpodobné údaje. Kliknutím na jméno otevřete doklady.</p>
<script>
  document.querySelectorAll<HTMLElement>('[data-tree]').forEach(tree => {
    const svg = tree.querySelector<SVGElement>('.strom')!;
    let zoom = 1;
    tree.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach(button => button.addEventListener('click', () => {
      zoom = button.dataset.zoom === 'fit' ? 1 : Math.max(1, Math.min(4, zoom + (button.dataset.zoom === 'in' ? .5 : -.5)));
      svg.style.width = `${zoom * 100}%`;
    }));
  });
</script>
<style>
  .tapestry { border:1px solid #766541;background:#101c19;box-shadow:0 24px 70px #0005; }
  .tree-tools { display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.8rem 1rem;color:#c8b681;font-size:.8rem;border-bottom:1px solid #766541; }
  .tree-tools button { background:transparent;color:#e0d2ad;border:1px solid #766541;padding:.4rem .7rem;cursor:pointer; }
  .tree-tools button:hover { background:#354136; }
  .strom-wrap { overflow:auto;max-height:80vh; }
  .strom { display:block;width:100%;height:auto; }
  .tree-caption { fill:#b9a777;font:15px Georgia,serif;letter-spacing:6px; }
  .person-name { fill:#ede0bc;font:17px Georgia,serif; }
  .initials { fill:#cdb579;font:17px Georgia,serif; }
  .person-years { fill:#b8ad91;font:12px Georgia,serif; }
  .missing-text { fill:#aaa084;font:italic 12px Georgia,serif; }
  .ancestor:hover .nameplate,.ancestor:focus .nameplate {fill:#384337;stroke:#f4dc98;stroke-width:2;}
  .ancestor.prob .person-name {font-style:italic;}
  .strom-legend {font-size:.8rem;color:var(--muted);}
  @media(max-width:640px) {.strom {min-width:1100px;}}
  @media print {.strom-wrap {max-height:none;overflow:visible}.strom {width:100%!important;min-width:0}}
</style>
