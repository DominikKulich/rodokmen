---
// Ilustrovaný strom předků: kmen = výchozí osoba, větve nahoru k předkům,
// jména na stuhách, listí podél větví, poupata = dosud neznámí předci.
import { byK, lineByK, href, config, lines } from '../lib/data.js';

const W = 2000, H = 1530, BASE = 1300, STEP = 148, MAXG = 7;
const medR = (g) => (g >= 5 ? 17 : 24);
const yOf = (g) => BASE - g * STEP - (g >= 7 ? 40 : 0);

// --- stavba stromu -------------------------------------------------------
function build(k, gen) {
  const p = byK[k];
  if (!p) return null;
  const n = { k, p, gen, kind: 'person', parents: [] };
  if (gen < MAXG) {
    for (const [pk, unk] of [[2 * k, p.fatherUnknown], [2 * k + 1, p.motherUnknown]]) {
      if (byK[pk]) n.parents.push(build(pk, gen + 1));
      else if (unk) n.parents.push({ k: pk, gen: gen + 1, kind: 'unknown', parents: [] });
      else n.parents.push({ k: pk, gen: gen + 1, kind: 'bud', parents: [] });
    }
  }
  return n;
}
const root = build(1, 0);
const own = (n) => (n.kind === 'bud' ? 0.42 : 1);
const width = (n) => (n.w ??= Math.max(own(n), n.parents.reduce((s, c) => s + width(c), 0)));
width(root);

function place(n, x0, x1) {
  if (!n.parents.length) { n.x = (x0 + x1) / 2; return; }
  const tot = n.parents.reduce((s, c) => s + c.w, 0);
  let x = x0;
  for (const c of n.parents) { const w = ((x1 - x0) * c.w) / tot; place(c, x, x + w); x += w; }
  const xs = n.parents.map((c) => c.x);
  n.x = (Math.min(...xs) + Math.max(...xs)) / 2;
}
// otcova a matčina strana: aspoň 30 % šířky, aby strom nebyl jednostranný
const [fa, mo] = root.parents;
const M = 90, inner = W - 2 * M;
const frac = Math.min(0.5, Math.max(0.24, fa.w / (fa.w + mo.w)));
place(fa, M, M + inner * frac);
place(mo, M + inner * frac, W - M);
root.x = W / 2;

const all = [];
(function walk(n) { all.push(n); n.parents.forEach(walk); })(root);
const persons = all.filter((n) => n.kind !== 'bud');
const buds = all.filter((n) => n.kind === 'bud');

// texty a šířky stuh
for (const n of persons) {
  n.name = n.kind === 'unknown' ? (n.k % 2 ? 'matka neuvedena' : 'otec neuveden') : n.p.name;
  n.years = n.kind === 'unknown' ? 'nemanželské dítě' : (n.p.years || '');
  n.hw = Math.max(58, n.name.length * 4.15 + 16);
  n.y = yOf(n.gen);
}
// střídání výšky, když se stuhy v jedné generaci nevejdou vedle sebe
for (let g = 1; g <= MAXG; g++) {
  const row = persons.filter((n) => n.gen === g).sort((a, b) => a.x - b.x);
  for (let i = 1; i < row.length; i++) {
    const a = row[i - 1], b = row[i];
    if (b.x - a.x < a.hw + b.hw + 30 && a.y === yOf(g)) b.y = yOf(g) - (g >= 5 ? 84 : 62);
  }
}
for (const n of buds) n.y = yOf(n.gen) + 20;

// --- větve ---------------------------------------------------------------
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const bez = (a, b, c, d, t) => (1 - t) ** 3 * a + 3 * (1 - t) ** 2 * t * b + 3 * (1 - t) * t * t * c + t ** 3 * d;
const branches = [];
const leaves = [];
const flowers = [];
const LEAF = ['#d8b44c', '#caa23c', '#e7c96c', '#a9b553', '#86a043', '#bfa046'];
for (const n of all) {
  for (const c of n.parents) {
    const x1 = n.x, y1 = n.y - (n.kind === 'bud' ? 0 : 21 + 2 * medR(n.gen)), x2 = c.x, y2 = c.y + (c.kind === 'bud' ? 0 : 22);
    const dy = y1 - y2;
    const cx1 = x1, cy1 = y1 - dy * 0.55, cx2 = x2, cy2 = y2 + dy * 0.45;
    const w = Math.max(3, 24 - 3.2 * n.gen) * (c.kind === 'bud' ? 0.55 : 1);
    branches.push({ d: `M${x1.toFixed(1)},${y1.toFixed(1)} C${cx1.toFixed(1)},${cy1.toFixed(1)} ${cx2.toFixed(1)},${cy2.toFixed(1)} ${x2.toFixed(1)},${y2.toFixed(1)}`, w });
    // listy podél větve, střídavě vlevo a vpravo
    const cnt = Math.round(Math.hypot(x2 - x1, dy) / 34);
    for (let i = 1; i < cnt; i++) {
      const t = 0.18 + (0.78 * i) / cnt + (rnd() - 0.5) * 0.04;
      const px = bez(x1, cx1, cx2, x2, t), py = bez(y1, cy1, cy2, y2, t);
      const tx = bez(x1, cx1, cx2, x2, t + 0.01) - px, ty = bez(y1, cy1, cy2, y2, t + 0.01) - py;
      const ang = (Math.atan2(ty, tx) * 180) / Math.PI;
      const side = i % 2 ? 1 : -1;
      const s = 0.75 + rnd() * 0.6;
      leaves.push(`<use href="#lst" transform="translate(${px.toFixed(1)},${py.toFixed(1)}) rotate(${(ang + side * (40 + rnd() * 25)).toFixed(0)}) scale(${s.toFixed(2)})" fill="${LEAF[Math.floor(rnd() * LEAF.length)]}"/>`);
      if (rnd() < 0.35) leaves.push(`<use href="#lst" transform="translate(${px.toFixed(1)},${py.toFixed(1)}) rotate(${(ang - side * (55 + rnd() * 20)).toFixed(0)}) scale(${(s * 0.7).toFixed(2)})" fill="${LEAF[Math.floor(rnd() * LEAF.length)]}"/>`);
      if (rnd() < 0.05 && c.kind !== 'bud') flowers.push([px + side * 22, py - 8, 0.6 + rnd() * 0.3]);
    }
  }
}
const leafSvg = leaves.join('');

// barva rodu
const lineColor = (n) => (n.p?.line && lineByK[n.p.line]?.color) || '#d9b44a';
const initials = (s) => s.replace(/\(.*?\)/g, '').trim().split(/\s+/).map((w) => w[0]).slice(0, 2).join('');
const rodNames = Object.values(lines).sort((a, b) => a.k - b.k).map((l) => l.name);
const banner = ['Kulichové', ...rodNames.filter((r) => r !== 'Kulichové')].join(' · ');
const title = config.nazev || 'Rodokmen';

// stuha: oblouk + zahnuté konce
const ribbon = (hw) => {
  const h = 21, e = 24;
  return {
    tails: `M${-hw + 6},-11 L${-hw - e},-11 L${-hw - e + 11},3 L${-hw - e},17 L${-hw + 6},17 Z M${hw - 6},-11 L${hw + e},-11 L${hw + e - 11},3 L${hw + e},17 L${hw - 6},17 Z`,
    folds: `M${-hw + 6},17 L${-hw},${h} L${-hw},13 Z M${hw - 6},17 L${hw},${h} L${hw},13 Z`,
    band: `M${-hw},${-h} Q0,${-h - 7} ${hw},${-h} L${hw},${h} Q0,${h - 7} ${-hw},${h} Z`,
  };
};
---
<div class="strom-wrap">
<svg class="strom" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Ilustrovaný strom předků – ${title}`}>
  <defs>
    <filter id="grain" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.0025 0.09" numOctaves="3" seed="4" />
      <feColorMatrix values="0 0 0 0 0.05  0 0 0 0 0.12  0 0 0 0 0.07  0 0 0 0.55 0" />
      <feComposite in2="SourceGraphic" operator="in" />
    </filter>
    <radialGradient id="vign" cx="50%" cy="48%" r="70%">
      <stop offset="55%" stop-color="#000" stop-opacity="0" />
      <stop offset="100%" stop-color="#000" stop-opacity="0.55" />
    </radialGradient>
    <linearGradient id="bark" x1="0" x2="1">
      <stop offset="0" stop-color="#1a120b" /><stop offset="0.45" stop-color="#3a2a1b" /><stop offset="1" stop-color="#140d08" />
    </linearGradient>
    <linearGradient id="parch" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#efe6cb" /><stop offset="1" stop-color="#d9cba4" />
    </linearGradient>
    <path id="lst" d="M0,0 C5,-6 14,-7 22,0 C14,7 5,6 0,0 Z M0,0 L20,0" stroke="#5b4a1c" stroke-width="0.6" />
    <g id="kvet">
      {[0, 72, 144, 216, 288].map((a) => <ellipse cx="0" cy="-7" rx="4.6" ry="7.5" transform={`rotate(${a})`} fill="#e3c2bb" stroke="#9b6f68" stroke-width="0.6" />)}
      <circle r="3.4" fill="#d9b44a" />
    </g>
    <g id="poupe">
      <path d="M0,10 C-7,2 -6,-8 0,-13 C6,-8 7,2 0,10 Z" fill="#e3c2bb" stroke="#9b6f68" stroke-width="0.8" />
      <path d="M0,10 C-3,4 -3,-4 0,-9" fill="none" stroke="#9b6f68" stroke-width="0.6" />
      <path d="M-6,8 C-9,12 -4,14 0,10 C4,14 9,12 6,8" fill="#86a043" />
    </g>
  </defs>

  <rect width={W} height={H} fill="#1f3a28" />
  <rect width={W} height={H} fill="#2c4d33" filter="url(#grain)" />
  <rect width={W} height={H} fill="url(#vign)" />
  <rect x="22" y="22" width={W - 44} height={H - 44} fill="none" stroke="#c9a13a" stroke-opacity="0.55" stroke-width="2" />
  <rect x="32" y="32" width={W - 64} height={H - 64} fill="none" stroke="#c9a13a" stroke-opacity="0.3" stroke-width="1" />

  <text x={W / 2} y="98" text-anchor="middle" class="t-title">{title}</text>
  <text x={W / 2} y="134" text-anchor="middle" class="t-sub">strom předků Dominika Kulicha</text>

  <!-- kořeny a kmen -->
  <g fill="none" stroke="#1d140c" stroke-linecap="round">
    <path d={`M${root.x - 30},${H - 150} C${root.x - 80},${H - 120} ${root.x - 150},${H - 115} ${root.x - 230},${H - 95}`} stroke-width="14" />
    <path d={`M${root.x + 30},${H - 150} C${root.x + 90},${H - 125} ${root.x + 160},${H - 118} ${root.x + 250},${H - 100}`} stroke-width="14" />
    <path d={`M${root.x - 10},${H - 140} C${root.x - 30},${H - 110} ${root.x - 60},${H - 95} ${root.x - 90},${H - 80}`} stroke-width="8" />
    <path d={`M${root.x + 12},${H - 140} C${root.x + 30},${H - 108} ${root.x + 70},${H - 96} ${root.x + 110},${H - 84}`} stroke-width="8" />
  </g>
  <path d={`M${root.x - 46},${H - 140} C${root.x - 30},${root.y + 40} ${root.x - 22},${root.y - 20} ${root.x - 18},${root.y - 70} L${root.x + 18},${root.y - 70} C${root.x + 22},${root.y - 20} ${root.x + 30},${root.y + 40} ${root.x + 46},${H - 140} Z`} fill="url(#bark)" />

  <!-- větve -->
  <g fill="none" stroke-linecap="round">
    {branches.map((b) => <path d={b.d} stroke="#1d140c" stroke-width={b.w + 3} />)}
    {branches.map((b) => <path d={b.d} stroke="#3b2b1c" stroke-width={b.w} />)}
    {branches.map((b) => <path d={b.d} stroke="#5a4430" stroke-width={Math.max(1, b.w * 0.25)} stroke-opacity="0.7" transform="translate(-1.5,0)" />)}
  </g>
  <g set:html={leafSvg} />
  {flowers.map(([x, y, s]) => <use href="#kvet" transform={`translate(${x.toFixed(1)},${y.toFixed(1)}) scale(${s.toFixed(2)})`} />)}

  <!-- poupata = neznámí předci -->
  {buds.map((n) => (
    <a href="/hledame/" class="bud">
      <title>{`${n.k % 2 ? 'Matka' : 'Otec'} zatím neznámý – hledáme`}</title>
      <use href="#poupe" transform={`translate(${n.x.toFixed(1)},${n.y.toFixed(1)})`} />
    </a>
  ))}

  <!-- osoby -->
  {persons.map((n) => {
    const r = ribbon(n.hw);
    const inner = (
      <g transform={`translate(${n.x.toFixed(1)},${n.y.toFixed(1)})`} class={`node st-${n.p?.st ?? 'unk'} ${n.kind}`}>
        <circle cy={-21 - medR(n.gen)} r={medR(n.gen)} fill="#1a2c1f" stroke={lineColor(n)} stroke-width="3" />
        <circle cy={-21 - medR(n.gen)} r={medR(n.gen) - 5} fill="none" stroke="#d9b44a" stroke-opacity="0.5" stroke-width="1" />
        <text y={-21 - medR(n.gen) + 7} text-anchor="middle" class="t-ini" font-size={n.gen >= 5 ? 15 : 20}>{n.kind === 'unknown' ? '?' : initials(n.name)}</text>
        <path d={r.tails} fill="#bfae86" stroke="#7d6a45" stroke-width="1" />
        <path d={r.folds} fill="#8c7a55" />
        <path d={r.band} fill="url(#parch)" stroke="#7d6a45" stroke-width="1.2" />
        <text y="-2" text-anchor="middle" class="t-name">{n.name}</text>
        <text y="14" text-anchor="middle" class="t-yrs">{n.years}</text>
        {n.p?.st === 'doc' && <g transform={`translate(${n.hw - 4},-20)`}><circle r="8" fill="#8e2b22" stroke="#5c1813" /><path d="M-3.5,0 L-1,3 L4,-3" fill="none" stroke="#f3d9a6" stroke-width="1.6" /></g>}
      </g>
    );
    return n.kind === 'person' ? <a href={href.person(n.p.slug)} class="pnode"><title>{`${n.name}${n.years ? ' (' + n.years + ')' : ''} – ${n.p.rel ?? ''}`}</title>{inner}</a> : inner;
  })}

  <!-- stuha s rody -->
  <g transform={`translate(${W / 2},${H - 62})`}>
    <path d="M-560,-6 L-640,-6 L-612,14 L-640,34 L-560,34 Z M560,-6 L640,-6 L612,14 L640,34 L560,34 Z" fill="#bfae86" stroke="#7d6a45" />
    <path d="M-560,-30 Q0,-44 560,-30 L560,30 Q0,16 -560,30 Z" fill="url(#parch)" stroke="#7d6a45" stroke-width="1.5" />
    <text y="7" text-anchor="middle" class="t-banner">{banner}</text>
  </g>
</svg>
</div>
<ul class="strom-legend">
  <li><svg width="22" height="22" viewBox="-11 -11 22 22"><circle r="8" fill="#8e2b22" /><path d="M-3.5,0 L-1,3 L4,-3" fill="none" stroke="#f3d9a6" stroke-width="1.6" /></svg> pečeť = doloženo zápisem z matriky</li>
  <li><svg width="22" height="22" viewBox="-11 -14 22 26"><use href="#poupe" /></svg> poupě = předek, kterého ještě hledáme</li>
  <li>barevný kroužek = rod (barvy jako na mapě); jméno se otazníkem = pravděpodobné</li>
</ul>

<style>
  .strom-wrap { overflow-x: auto; border-radius: 12px; box-shadow: 0 6px 30px rgba(0,0,0,.35); background: #1f3a28; }
  .strom { display: block; width: 100%; min-width: 1100px; height: auto; }
  .t-title { font: italic 54px Georgia, 'Times New Roman', serif; fill: #e7c96c; letter-spacing: 2px; }
  .t-sub { font: 22px Georgia, serif; fill: #cdbb8a; letter-spacing: 4px; font-variant: small-caps; }
  .t-name { font: 15px Georgia, serif; fill: #33261a; font-variant: small-caps; letter-spacing: 0.3px; }
  .t-yrs { font: 12.5px Georgia, serif; fill: #6a5536; }
  .t-ini { font-family: Georgia, serif; fill: #e7c96c; }
  .t-banner { font: 26px Georgia, serif; fill: #3a2c1a; letter-spacing: 3px; font-variant: small-caps; }
  .pnode { cursor: pointer; }
  .pnode:hover .t-name, .pnode:focus .t-name { fill: #8e2b22; }
  .pnode:hover circle:first-child { stroke-width: 5; }
  .node.unknown { opacity: 0.75; }
  .node.st-prob .t-name { font-style: italic; }
  .bud { cursor: help; }
  .strom-legend { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; font-size: .88rem; color: var(--muted); margin-top: .8rem; }
  .strom-legend li { display: flex; align-items: center; gap: .4rem; }
</style>
