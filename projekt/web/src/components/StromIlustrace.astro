import { byK, href, config, records } from '../lib/data.js';
// Rok zmínky se nikdy nevydává za datum narození ani důkaz, že osoba tehdy žila.
function timeLabel(p) {
  if (p.years) return p.years;
  const dates = [...new Set((p.records || []).flatMap(key => {
    const year = records[key]?.date?.match(/\b\d{4}\b/);
    return year ? [Number(year[0])] : [];
  }))].sort((a,b) => a-b);
  return dates.length ? `zmínka ${dates[0]}${dates.length > 1 ? '–' + dates[dates.length-1] : ''}` : 'doba zatím neurčena';
}
const DAMASK = `<path transform="translate(80.0,80.0) rotate(0) scale(1.0)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(80.0,80.0) rotate(90) scale(1.0)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(80.0,80.0) rotate(180) scale(1.0)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(80.0,80.0) rotate(270) scale(1.0)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(80.0,80.0) rotate(45) scale(0.55)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(80.0,80.0) rotate(135) scale(0.55)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(80.0,80.0) rotate(225) scale(0.55)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(80.0,80.0) rotate(315) scale(0.55)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><circle cx="80.0" cy="80.0" r="3.2"/><path transform="translate(0,0) rotate(0) scale(0.62)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(0,0) rotate(90) scale(0.62)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(0,0) rotate(180) scale(0.62)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(0,0) rotate(270) scale(0.62)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(0,0) rotate(45) scale(0.341)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(0,0) rotate(135) scale(0.341)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(0,0) rotate(225) scale(0.341)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(0,0) rotate(315) scale(0.341)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><circle cx="0" cy="0" r="1.984"/><path transform="translate(0,160) rotate(0) scale(0.62)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(0,160) rotate(90) scale(0.62)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(0,160) rotate(180) scale(0.62)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(0,160) rotate(270) scale(0.62)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(0,160) rotate(45) scale(0.341)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(0,160) rotate(135) scale(0.341)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(0,160) rotate(225) scale(0.341)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(0,160) rotate(315) scale(0.341)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><circle cx="0" cy="160" r="1.984"/><path transform="translate(160,0) rotate(0) scale(0.62)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(160,0) rotate(90) scale(0.62)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(160,0) rotate(180) scale(0.62)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(160,0) rotate(270) scale(0.62)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(160,0) rotate(45) scale(0.341)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(160,0) rotate(135) scale(0.341)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(160,0) rotate(225) scale(0.341)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(160,0) rotate(315) scale(0.341)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><circle cx="160" cy="0" r="1.984"/><path transform="translate(160,160) rotate(0) scale(0.62)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(160,160) rotate(90) scale(0.62)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(160,160) rotate(180) scale(0.62)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(160,160) rotate(270) scale(0.62)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(160,160) rotate(45) scale(0.341)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(160,160) rotate(135) scale(0.341)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(160,160) rotate(225) scale(0.341)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><path transform="translate(160,160) rotate(315) scale(0.341)" d="M0,0 C7,-9 8,-24 0,-34 C-8,-24 -7,-9 0,0Z"/><circle cx="160" cy="160" r="1.984"/><g transform="translate(110.0,50.0) rotate(-45) scale(0.9)"><path d="M0,0 C10,-6 18,-2 22,6 C25,13 20,19 14,17" fill="none" stroke-width="1.6"/><path d="M8,-3 C10,-12 18,-14 22,-10 C18,-6 13,-3 8,-3Z"/><path d="M19,3 C27,1 32,6 31,11 C26,10 22,8 19,3Z"/></g><g transform="translate(110.0,110.0) rotate(45) scale(0.9)"><path d="M0,0 C10,-6 18,-2 22,6 C25,13 20,19 14,17" fill="none" stroke-width="1.6"/><path d="M8,-3 C10,-12 18,-14 22,-10 C18,-6 13,-3 8,-3Z"/><path d="M19,3 C27,1 32,6 31,11 C26,10 22,8 19,3Z"/></g><g transform="translate(50.0,110.0) rotate(135) scale(0.9)"><path d="M0,0 C10,-6 18,-2 22,6 C25,13 20,19 14,17" fill="none" stroke-width="1.6"/><path d="M8,-3 C10,-12 18,-14 22,-10 C18,-6 13,-3 8,-3Z"/><path d="M19,3 C27,1 32,6 31,11 C26,10 22,8 19,3Z"/></g><g transform="translate(50.0,50.0) rotate(225) scale(0.9)"><path d="M0,0 C10,-6 18,-2 22,6 C25,13 20,19 14,17" fill="none" stroke-width="1.6"/><path d="M8,-3 C10,-12 18,-14 22,-10 C18,-6 13,-3 8,-3Z"/><path d="M19,3 C27,1 32,6 31,11 C26,10 22,8 19,3Z"/></g>`;
const nodes = [];
function branch(k, g = 0) {
  const p = byK[k];
  const n = { k, g, p, children: [], x: 0, y: 0, span: p ? 1 : .32 };
  nodes.push(n);
  if (p && g < 10) {
    n.children = [branch(k * 2, g + 1), branch(k * 2 + 1, g + 1)];
    n.span = Math.max(1, n.children.reduce((s, c) => s + c.span, 0));
  }
  return n;
}
const root = branch(1);
const baseW = Math.max(1600, root.span * 182 + 160);
const W = baseW;
const H = Math.max(...nodes.map(n => n.g)) * 190 + 360;
function place(n, left) {
  n.x = left + n.span * 91;
  n.y = H - 200 - n.g * 190;
  let next = left + (n.span - n.children.reduce((s,c) => s+c.span,0)) * 91;
  for (const c of n.children) { place(c, next); next += c.span * 182; }
}
place(root, (baseW - root.span * 182) / 2);
// Vedlejší příbuzní mají vlastní identifikátory, nikoli Kekulého čísla předků.
const commonFather = nodes.find(n => n.k === 48);
const familyY = commonFather.y;
const legionX = commonFather.x;
const lateral = [
  {id:'legion-father',x:legionX,y:familyY+190,name:'František Polák',years:'* asi 1860',sex:'M',url:'/zdroj/cunin_snatek_frantisek_polak_marie_trnkova_1887/',seed:901},
  {id:'legionnaire',x:legionX,y:familyY+380,name:'František Polák',years:'* 4. 7. 1890',sex:'M',url:'/legionar/',seed:905,legionnaire:true},
];
lateral.forEach(p => nodes.push({k:p.id,g:4,x:p.x,y:p.y,span:1,children:[],url:p.url,legionnaire:p.legionnaire,p:{name:p.name,years:p.years,sex:p.sex,artSeed:p.seed,gen:4,st:'doc',records:[],side:[],docs:p.legionnaire?[{img:'frantisek-polak-legionar-foto-2',caption:'Archivní fotografie ČsOL'}]:[]}}));
const bez = (a,b,c,d,t) => (1-t)**3*a+3*(1-t)**2*t*b+3*(1-t)*t*t*c+t**3*d;
const foliage = nodes.flatMap(n => n.children.flatMap(c => {
  const y1=n.y-58, y2=c.y+58;
  return Array.from({length:Math.max(3,Math.ceil(Math.abs(c.x-n.x)/55))},(_,i) => {
    const count=Math.max(3,Math.ceil(Math.abs(c.x-n.x)/55));
    const t=.15+.7*i/count;
    return { x:bez(n.x,n.x,c.x,c.x,t),y:bez(y1,n.y-118,c.y+110,y2,t),angle:(i%2?1:-1)*(35+i%3*15),scale:.55+(i%4)*.12 };
  });
}));
// Malovaný portrét: vlastní busta podle pohlaví a doby (bez fotky), nebo fotka z rodinných dokumentů s „foto“/„portrét“ v popisu.
const birthYear = (p) => Number((p.years || '').match(/\d{4}/)?.[0]) || (p.gen >= 3 ? 1850 : 1940);
const pick = (arr, k) => arr[k % arr.length];
const photoOf = (p) => (p.docs || []).find((d) => /foto|portr/i.test(d.caption || ''));
function portrait(p) {
  const old = birthYear(p) < 1900, k = p.artSeed ?? p.k;
  const skin = pick(['#e0b893', '#d6a982', '#e8c4a0', '#cfa17a'], k);
  const hair = pick(['#3a2a1e', '#5a3d24', '#24180f', '#6e5032', '#8a6a48'], k + 1);
  const cloth = pick(['#46583a', '#6b2f2a', '#3b4a5e', '#5b4a2e', '#2f4a44', '#4b3a52'], k);
  const scarf = pick(['#8e2b22', '#b2873a', '#3f5a7a', '#6d3b5c', '#a0522d', '#2f5e4e'], k + 2);
  const face = `<ellipse cx="0" cy="-5" rx="9.6" ry="12" fill="${skin}"/><ellipse cx="-3.6" cy="-6" rx="1.2" ry="1.4" fill="#2b1d12"/><ellipse cx="3.6" cy="-6" rx="1.2" ry="1.4" fill="#2b1d12"/><path d="M-3,2.5 Q0,4.2 3,2.5" stroke="#8a4b3a" stroke-width="1" fill="none"/><ellipse cx="-5.5" cy="0" rx="2.2" ry="1.4" fill="#d9776a" opacity=".25"/><ellipse cx="5.5" cy="0" rx="2.2" ry="1.4" fill="#d9776a" opacity=".25"/>`;
  const neck = `<rect x="-4.5" y="4" width="9" height="10" fill="${skin}"/>`;
  if (p.sex === 'F') {
    if (old) return neck + `<path d="M-32,44 C-30,20 -16,13 0,13 C16,13 30,20 32,44Z" fill="${cloth}"/><path d="M-12,14 Q0,22 12,14 L9,24 Q0,28 -9,24Z" fill="#efe6cf"/>`
      + `<path d="M-14,-2 C-16,-24 16,-24 14,-2 L13,10 C8,15 -8,15 -13,10Z" fill="${scarf}"/>` + face
      + `<path d="M-11,-11 C-8,-19 8,-19 11,-11" fill="none" stroke="${scarf}" stroke-width="5"/><path d="M-3,9 l3,5 3,-5 4,8 -7,-2 -7,2Z" fill="${scarf}"/><path d="M-12,-8 q12,-10 24,0" stroke="#f3e2b8" stroke-width=".8" fill="none" opacity=".6"/>`;
    return `<ellipse cx="0" cy="-6" rx="13" ry="15" fill="${hair}"/>` + neck + `<path d="M-31,44 C-29,20 -15,13 0,13 C15,13 29,20 31,44Z" fill="${cloth}"/><path d="M-8,13 Q0,20 8,13" fill="none" stroke="#efe6cf" stroke-width="2.5"/>`
      + face + `<path d="M-10,-8 C-9,-19 9,-19 10,-8 C6,-14 -4,-15 -10,-8Z" fill="${hair}"/><circle cx="0" cy="-19" r="5" fill="${hair}"/>`;
  }
  if (old) return neck + `<path d="M-32,44 C-30,19 -16,12 0,12 C16,12 30,19 32,44Z" fill="${cloth}"/><path d="M-9,12 L0,30 L9,12Z" fill="#7a5a32"/><path d="M-6,12 L0,22 L6,12Z" fill="#f1ead8"/><circle cx="0" cy="25" r="1" fill="#d9b44a"/><circle cx="0" cy="30" r="1" fill="#d9b44a"/>`
    + face + `<path d="M-10.2,-8 C-11,-20 11,-20 10.2,-8 C8,-14 -8,-14 -10.2,-8Z" fill="${hair}"/><path d="M-6.5,1.6 C-3.5,-0.6 -1,0.4 0,1.4 C1,0.4 3.5,-0.6 6.5,1.6 C3.5,3.6 -3.5,3.6 -6.5,1.6Z" fill="${hair}"/>`;
  return neck + `<path d="M-32,44 C-30,19 -16,12 0,12 C16,12 30,19 32,44Z" fill="${cloth}"/><path d="M-7,12 L0,26 L7,12Z" fill="#f1ead8"/><path d="M-1.8,14 L1.8,14 L2.6,28 L0,31 L-2.6,28Z" fill="${scarf}"/>`
    + face + `<path d="M-10.2,-7 C-11,-21 11,-21 10.2,-7 C9,-13 2,-15 -4,-13 C-7,-12 -9,-10 -10.2,-7Z" fill="${hair}"/>`;
}
const sibLabel = (c) => `${c} ${c === 1 ? 'sourozenec' : c < 5 ? 'sourozenci' : 'sourozenců'}`;
const fit = (t, max, px) => (t.length * px > max ? { textLength: max, lengthAdjust: 'spacingAndGlyphs' } : {});
const initials = (name) => name.replace(/\(.*?\)/g, '').trim().split(/\s+/).slice(0, 2).map(s => s[0]).join('');
const status = { doc: 'Osoba doložena zápisem', fam: 'Údaj od rodiny', prob: 'Pravděpodobné' };
const missing = n => byK[Math.floor(n.k/2)]?.[n.k % 2 ? 'motherUnknown' : 'fatherUnknown'] ? 'v zápisu neuvedeno' : 'dosud hledáme';
