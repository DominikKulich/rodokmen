        <use href="#leaf" transform={`translate(${c.x},${c.y+82}) rotate(40) scale(.7)`}/><use href="#leaf" transform={`translate(${c.x},${c.y+96}) rotate(-45) scale(.65)`}/>
      </g>))}
      <g opacity=".75" aria-hidden="true">{foliage.map(l => <use href="#leaf" transform={`translate(${l.x} ${l.y}) rotate(${l.angle}) scale(${l.scale})`}/>)}</g>
      <g fill="none" stroke="url(#paint-bark)" stroke-width="5">
        <path d={`M${legionX} ${familyY+64}C${legionX-5} ${familyY+74} ${legionX+5} ${familyY+82} ${legionX} ${familyY+92}`}/>
        <path d={`M${legionX} ${familyY+254}C${legionX-5} ${familyY+264} ${legionX+5} ${familyY+272} ${legionX} ${familyY+282}`}/>
      </g>
      {nodes.map(n => n.p ? <g><a href={n.url || href.person(n.p.slug)} class={`ancestor ${n.p.st}`}>
        <title>{n.p.name} · {status[n.p.st] || 'Neověřeno'}{n.p.parentLink === 'prob' ? ' · Vazba k dítěti nepotvrzena' : ''}</title>
        <g transform={`translate(${n.x},${n.y})`}>
          <path class="nameplate" d="M-82-18Q-86-25-78-30H-28Q0-42 28-30H78Q86-25 82-18V32H-82Z" fill="url(#portrait)" stroke="url(#antique-gold)" stroke-width="2"/>
          <path d="M-85-20q-18 12-7 26M85-20q18 12 7 26M-66 30q66 15 132 0" fill="none" stroke="url(#antique-gold)" stroke-width="2"/>
          <g transform="translate(0,-62)">
            <ellipse rx="28" ry="34" fill="url(#ovalBg)"/>
            <g clip-path="url(#oval)">
              {photoOf(n.p)
                ? <image href={`/img/${photoOf(n.p).img}.jpg`} x="-28" y="-34" width="56" height="68" preserveAspectRatio={photoOf(n.p).align || 'xMidYMid slice'}/>
                : <g transform="translate(0,4) scale(.95)" set:html={portrait(n.p)}/>}
              <ellipse rx="28" ry="34" fill="url(#ovalLight)"/><ellipse rx="28" ry="34" fill="url(#ovalShade)"/>
            </g>
            <ellipse rx="28" ry="34" fill="none" stroke="url(#antique-gold)" stroke-width="3.5"/>
            <ellipse rx="31.5" ry="37.5" fill="none" stroke="#cfb477" stroke-opacity=".55" stroke-width="1"/>
          </g>
          <text y="-6" text-anchor="middle" class="person-name" {...fit(n.p.name.split(' ')[0], 150, 11)}>{n.p.name.split(' ')[0]}</text>
          <text y="16" text-anchor="middle" class="person-name surname" {...fit(n.p.name.split(' ').slice(1).join(' '), 152, 11.5)}>{n.p.name.split(' ').slice(1).join(' ')}</text>
          <text y="56" text-anchor="middle" class="person-years">{timeLabel(n.p)}</text>
          {n.legionnaire && <text y="84" text-anchor="middle" class="person-years">LEGIONÁŘ · RUSKO</text>}
          {n.p.st === 'doc' && <circle cx="79" cy="-29" r="5" fill="#d2be88"/>}
        </g>
      </a>
      {(n.p.side || []).length > 0 && <a href={`${href.person(n.p.slug)}#sourozenci`} class="sib-badge">
        <title>{'Sourozenci a příbuzní: ' + n.p.side.map(x => x.name).join(', ')}</title>
        <g transform={`translate(${n.x},${n.y + 80})`}>
          <rect x="-66" y="-12" width="132" height="22" rx="11" fill="#16261c" stroke="url(#antique-gold)" stroke-width="1.2"/>
          {n.p.side.slice(0, 5).map((x, i) => <use href="#leaf" transform={`translate(${-56 + i * 4},5) rotate(${-25 + i * 12}) scale(.28)`}/>)}
          <text x="12" y="4" text-anchor="middle" class="sib-text">{sibLabel(n.p.side.length)}</text>
        </g>
      </a>}
      </g> : <a href="/hledame/"><title>{missing(n)}</title><path d={`M${n.x} ${n.y-12}l10 16-10 16-10-16Z`} fill="none" stroke="#8c805f"/><text x={n.x} y={n.y+40} text-anchor="middle" class="missing-text">{missing(n)}</text></a>)}
      <use href="#flourish" transform={`translate(${W/2} ${H-72}) scale(.8)`}/>
      <text x={W/2} y={H-48} text-anchor="middle" class="tree-caption">KAŽDÉ JMÉNO MÁ SVŮJ PŘÍBĚH</text>
    </svg>
  </div>
</div>
<p class="strom-legend">Přímo pod Janem Polákem (* asi 1838) je jeho syn František a pod ním vnuk František — legionář. Matkou staršího Františka byla Anna Pospíšilová. Tlačítkem „Legionář a otec“ větev přiblížíte. Zlatý bod: osoba zachycená v matrice · Přerušovaná větev: nepotvrzené příbuzenství · Kurzíva: pravděpodobné údaje. „Zmínka“ označuje rok zápisu, nikoli narození či úmrtí. Kliknutím na jméno otevřete doklady.</p>
