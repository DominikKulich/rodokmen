---
import Base from '../../layouts/Base.astro';
import PersonLink from '../../components/PersonLink.astro';
import Record from '../../components/Record.astro';
import Pedigree from '../../components/Pedigree.astro';
import MobileTree from '../../components/MobileTree.astro';
import { people, families, lineByK, records, dateKey, href, statusClass, config } from '../../lib/data.js';
import { povolaniV, vlastniFakta } from '../../lib/povolani.js';

export function getStaticPaths() {
  return Object.keys(people).map((slug) => ({ params: { slug } }));
}
const p = people[Astro.params.slug];
const line = p.line ? lineByK[p.line] : null;
const recs = [...new Set(p.records)].filter((r) => records[r]).sort((a, b) => dateKey(records[a].date) - dateKey(records[b].date));
const path = [...p.path].reverse().filter(Boolean);
const portrait = p.docs.find(d => /foto|portr/i.test(d.caption));
const documents = p.docs.filter(d => d !== portrait);
---
<Base title={p.name} description={`${p.name} ${p.years} – ${p.rel}`}>
  <div class="crumbs">
    {path.map((s, i) => <>{i > 0 && <span>→</span>}{s === p.slug ? <span>{people[s].name}</span> : <a href={href.person(s)}>{people[s].name.split(' ')[0]} {people[s].years}</a>}</>)}
  </div>
  <p class="print-only print-head">{config.nazev} – rodový list</p>
  <div class:list={['person-heading', { 'with-portrait': portrait }]}><div>
  <h1>{p.name}</h1>
  <div class="chips">
    {p.years && <span class="chip">{p.years}</span>}
    <span class="chip">{p.rel}</span>
    {line && <a class="chip" href={href.line(line.slug)}><span class="dot" style={`background:${line.color}`}></span>rod {line.name}</a>}
    <span class={`chip ${statusClass(p.st)}`}>{p.status}</span>
  </div>
  </div>
  {portrait && <figure class="person-portrait"><a href={`/zdroje/${portrait.img}.jpg`} target="_blank" rel="noopener"><img src={`/img/${portrait.img}.jpg`} alt={portrait.caption} fetchpriority="high" /></a><figcaption>{portrait.caption}</figcaption></figure>}
  </div>
  <div class="print-bar no-print"><button type="button" class="btn btn-light" onclick="window.print()">🖨 Rodový list / PDF</button><a class="btn btn-light" href="/kniha/">Celá rodová kniha</a></div>

  {p.also.length > 0 && (
    <p class="note">V rodokmenu dvakrát – pedigree collapse: je předkem přes {p.children.map((c, i) => <>{i > 0 && ' i přes '}<PersonLink slug={c} /></>)}.
      Podruhé jako {p.also.map((a) => a.rel).join(', ')}.</p>
  )}
  {p.parentLink === 'prob' && <p class="note">Příbuzenství k dítěti v této linii zatím není potvrzeno přímým dokladem. Doložení osoby v matrice samo o sobě tuto vazbu nepotvrzuje.</p>}
  {p.facts.length > 0 && <ul class="facts">{p.facts.map((f) => <li>{f}</li>)}</ul>}
  {(() => { const pv = povolaniV(vlastniFakta(p.facts).join(' ')); return pv.length > 0 && (
    <details class="pov-note" open>
      <summary>Co to tehdy znamenalo</summary>
      {pv.map((x) => <p class="small"><b>{x.k}</b> – {x.text} <a href={`/statistiky/#pov-${x.k}`}>další v rodu →</a></p>)}
    </details>); })()}
  {p.note && <p class="note">{p.note}</p>}

  <h2>Rodina</h2>
  <div class="grid2">
    <div class="card">
      <h3>Rodiče</h3>
      <p>Otec: {p.father ? <PersonLink slug={p.father} /> : <span class="muted">{p.fatherUnknown ? 'neuveden (nemanželské dítě)' : 'zatím neznámý'}</span>}<br />
        Matka: {p.mother ? <PersonLink slug={p.mother} /> : <span class="muted">zatím neznámá</span>}</p>
      {p.family && <p class="small"><a href={href.family(p.family)}>Rodina, ze které pochází →</a></p>}
    </div>
    {p.child && (
      <div class="card">
        <h3>{p.sex === 'M' ? 'Manželka' : 'Manžel'} a dítě v linii</h3>
        <p>{p.spouse ? <PersonLink slug={p.spouse} /> : <span class="muted">{p.sex === 'F' && people[p.child]?.fatherUnknown ? 'otec dítěte neuveden' : 'neznámý partner'}</span>}<br />
          {p.children.length > 1 ? 'Děti' : 'Dítě'}: {p.children.map((c, i) => <>{i > 0 && ', '}<PersonLink slug={c} /></>)}</p>
        {p.ownFamily && <p class="small"><a href={href.family(p.ownFamily)}>Jejich rodina →</a></p>}
      </div>
    )}
  </div>

  {p.side.length > 0 && (
    <>
      <h2 id="sourozenci">Sourozenci a další příbuzní</h2>
      <div class="grid2">
        {p.side.map((s) => (
          <div class="card"><h3>{s.name}</h3><p class="small">{s.text}</p>
            {s.records.filter((r) => records[r]).map((r) => <Record id={r} />)}
          </div>
        ))}
      </div>
    </>
  )}

  <h2>Předci</h2>
  <div class="only-desktop"><Pedigree k={p.k} /></div>
  <div class="only-mobile"><MobileTree k={p.k} /></div>

  {documents.length > 0 && (
    <>
      <h2>Rodinné dokumenty</h2>
      <div class="docs">{documents.map((d) => <figure><a href={`/img/${d.img}.jpg`} target="_blank" rel="noopener"><img src={`/img/${d.img}.jpg`} alt={d.caption} loading="lazy" /></a><figcaption>{d.caption}</figcaption></figure>)}</div>
    </>
  )}

  <h2>Zápisy z matrik</h2>
  {recs.length > 1 && <p class="small muted no-print">Zápisy vedle sebe – rozdíly mezi nimi (třeba v datech) jsou uvedené v poznámce.</p>}
  {recs.length ? <div class={`recs${recs.length > 1 ? ' compare' : ''}`}>{recs.map((r) => <Record id={r} showPeople exclude={p.slug} />)}</div>
    : <p class="muted">K této osobě zatím nemáme vlastní matriční zápis – údaje pocházejí ze zápisů jejích dětí{p.st === 'fam' ? ' nebo od rodiny' : ''}.</p>}
</Base>
<style>
  .person-heading.with-portrait {display:grid;grid-template-columns:minmax(0,1fr) 240px;gap:1.5rem;align-items:center;margin:1rem 0;}
  .person-portrait {margin:0;}
  .person-portrait a {display:block;border:4px double var(--gold);padding:5px;background:var(--paper);}
  .person-portrait img {display:block;width:100%;height:auto;}
  .person-portrait figcaption {font-size:.75rem;line-height:1.5;color:var(--muted);margin-top:.5rem;}
  @media(max-width:600px) {.person-heading.with-portrait {grid-template-columns:1fr;}.person-portrait {max-width:280px;}}
  .pov-note { background: var(--accent-soft, #eadfbf); border-left: 4px solid var(--gold, #c9a13a); border-radius: 6px; padding: .5rem .9rem; margin: .6rem 0 1rem; max-width: 46rem; }
  .pov-note summary { cursor: pointer; font-weight: 600; color: var(--wood, #1f3a28); }
  .pov-note p { margin: .4rem 0; }
</style>
