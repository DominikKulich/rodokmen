---
import Base from '../../layouts/Base.astro';
import LegionarKarta from '../../components/LegionarKarta.astro';
import PersonLink from '../../components/PersonLink.astro';
import { places, people, lineByK, recordList, href, placeSlug, dateKey } from '../../lib/data.js';
export function getStaticPaths() {
  return places.map((pl) => ({ params: { slug: placeSlug(pl.name) }, props: { pl } }));
}
const { pl } = Astro.props;
const short = pl.name.split(' ')[0];
const ppl = [...new Set(pl.lines.flatMap((l) => l.people))].map((s) => people[s]).filter(Boolean).sort((a, b) => b.gen - a.gen);
// fakta osob, která obec zmiňují
const facts = Object.values(people).flatMap((p) => (p.facts || []).filter((f) => f.includes(pl.name) || f.includes(short)).map((f) => ({ p, f })))
  .sort((a, b) => dateKey(a.f) - dateKey(b.f));
const recs = recordList.filter((r) => [r.title, r.summary, r.vdesc].join(' ').includes(short));
// domy: „čp. 26“ ve faktech osob z této obce
const houses = {};
for (const { p, f } of facts) for (const m of f.matchAll(/čp\.\s*(\d+)/g)) {
  const y = (f.match(/\d{4}/) || [''])[0];
  (houses[m[1]] ??= []).push({ p, y, f });
}
const houseList = Object.entries(houses).sort((a, b) => b[1].length - a[1].length || +a[0] - +b[0]);
const lns = pl.lines.map((l) => lineByK[l.k]).filter(Boolean);
const [y0, y1] = pl.years || [];
---
<Base title={pl.name}>
  <p class="crumbs"><a href="/mapa/">Mapa</a> › <a href="/obce/">Obce</a> › {pl.name}</p>
  <h1>{pl.name}{pl.hypothesis && <span class="muted"> (?)</span>}</h1>
  {pl.de && <p class="muted" style="margin-top:-.4rem">německy <i>{pl.de}</i> – pod tímto jménem obec najdete ve starých matrikách, úředních záznamech a ztrátových seznamech</p>}
  <p class="lead">
    {ppl.length} {ppl.length === 1 ? 'předek' : ppl.length < 5 ? 'předci' : 'předků'}
    {y0 && <> · doloženo {y0 === y1 ? y0 : `${y0}–${y1}`}</>}
  </p>
  {lns.length > 0 && <div class="chips">{lns.map((l) => <a class="chip" href={href.line(l.slug)}><span class="dot" style={`background:${l.color}`}></span>{l.name}</a>)}</div>}

  <h2>Předci z obce</h2>
  {short==='Čunín' && <LegionarKarta />}
  <ul class="facts">{ppl.map((p) => <li><PersonLink slug={p.slug} /> <span class="small muted">– {p.rel}</span></li>)}</ul>

  {facts.length > 0 && <>
    <h2>Co o obci víme z matrik a od rodiny</h2>
    <ul class="facts">{facts.map(({ p, f }) => <li>{f} <span class="small muted">({p.name})</span></li>)}</ul>
  </>}

  {houseList.length > 0 && <>
    <h2>Domy</h2>
    <div class="grid2">
      {houseList.map(([cp, xs]) => {
        const yrs = xs.map((x) => +x.y).filter(Boolean);
        const who = [...new Set(xs.map((x) => x.p.slug))];
        return (
          <div class="card">
            <h3>čp. {cp}</h3>
            {who.length > 1 && yrs.length > 1 && <p class="small"><b>{who.length} generace v jednom domě</b>{Math.max(...yrs) > Math.min(...yrs) && ` – doloženo ${Math.min(...yrs)}–${Math.max(...yrs)}`}</p>}
            <ul class="facts small">{xs.map((x) => <li><a href={href.person(x.p.slug)}>{x.p.name}</a>: {x.f}</li>)}</ul>
          </div>
        );
      })}
    </div>
  </>}

  {recs.length > 0 && <>
    <h2>Zápisy</h2>
    <ul class="facts">{recs.map((r) => <li><a href={href.record(r.key)}>{r.title}</a> <span class="small muted">{r.date}</span></li>)}</ul>
  </>}

  <h2>Odkazy</h2>
  <ul class="facts">
    <li><a href={`/mapa/#misto-${placeSlug(pl.name)}`}>Na mapě rodu</a></li>
    <li><a href={`https://cs.wikipedia.org/wiki/${encodeURIComponent(pl.name)}`} rel="noopener">Wikipedie – historie obce</a></li>
    <li><a href={`https://mapy.cz/zakladni?q=${encodeURIComponent(pl.name)}`} rel="noopener">Mapy.cz</a> · <a href={`https://ags.cuzk.cz/archiv/?q=${encodeURIComponent(pl.name)}`} rel="noopener">Staré mapy (císařské otisky, ČÚZK)</a></li>
  </ul>
</Base>
