---
// Rodová kniha: všichni předci po generacích na jedné stránce – určená k tisku do PDF.
import Base from '../layouts/Base.astro';
import Record from '../components/Record.astro';
import StromIlustrace from '../components/StromIlustrace.astro';
import LegionarKarta from '../components/LegionarKarta.astro';
import LegionarSouvislosti from '../components/LegionarSouvislosti.astro';
import { people, records, config, genName, href, dateKey, statusClass, recordList, stats } from '../lib/data.js';
const all = Object.values(people).sort((a, b) => a.k - b.k);
const gens = [...new Set(all.map((p) => p.gen))].sort((a, b) => a - b).map((g) => ({ g, ps: all.filter((p) => p.gen === g) }));
const recsOf = (p) => [...new Set(p.records)].filter((r) => records[r]).sort((a, b) => dateKey(records[a].date) - dateKey(records[b].date));
// zápis ukázat jen u první osoby, které se týká (aby se v knize neopakoval)
const shown = new Set();
const today = new Date().toLocaleDateString('cs-CZ');
---
<Base title="Rodová kniha" wide>
  <div class="print-bar no-print">
    <button type="button" class="btn" onclick="window.print()">🖨 Vytisknout / uložit jako PDF</button>
    <span class="small muted">V dialogu tisku zvolte „Uložit jako PDF“, A4, a zapněte „Grafika na pozadí“.</span>
  </div>

  <section class="kn-cover">
    <h1>{config.nazev}</h1>
    <p class="lead">Rodová kniha · {stats.ancestors} předků v {stats.generations} generacích · {recordList.length} dochovaných pramenů</p>
    <div class="kn-tree"><StromIlustrace /></div>
    <p class="small muted">Stav k {today}. Ke každému údaji z matrik je uveden zápis s výřezem, přepisem a překladem.</p>
  </section>

  <section class="page-break">
    <h2>Obsah</h2>
    <ol class="kn-toc">
      <li><a href="#legionar-v-knize">Legionář v rodině – František Polák (*1890)</a></li>
      {gens.map(({ g, ps }) => <li><a href={`#gen-${g}`}>{g === 0 ? 'Výchozí osoba' : genName(g)[0].toUpperCase() + genName(g).slice(1)}</a> <span class="muted small">– {ps.map((p) => p.name).join(', ')}</span></li>)}
    </ol>
  </section>

  <section class="page-break" id="legionar-v-knize">
    <h2>Legionář v naší rodině</h2><LegionarKarta /><LegionarSouvislosti />
    <h3>Doklady legionářské větve</h3>
    <div class="recs">{['cunin_krest_frantisek_polak_1890_legionar','cunin_snatek_frantisek_polak_marie_trnkova_1887','legie_frantisek_polak_1890'].map(id=><Record id={id} open />)}</div>
  </section>
  {gens.map(({ g, ps }) => (
    <section class="page-break" id={`gen-${g}`}>
      <h2>{g === 0 ? 'Výchozí osoba' : genName(g)[0].toUpperCase() + genName(g).slice(1)}</h2>
      {ps.map((p) => {
        const rs = recsOf(p).filter((r) => !shown.has(r));
        rs.forEach((r) => shown.add(r));
        return (
          <article class="kn-person" id={p.slug}>
            <h3><span class="kn-k">{p.k}</span> <a href={href.person(p.slug)}>{p.name}</a> <span class="muted small">{p.years}</span></h3>
            <div class="chips"><span class="chip">{p.rel}</span><span class={`chip ${statusClass(p.st)}`}>{p.status}</span></div>
            {p.facts.length > 0 && <ul class="facts">{p.facts.map((f) => <li>{f}</li>)}</ul>}
            <p class="small">
              Otec: {p.father ? <a href={`#${p.father}`}>{people[p.father].name}</a> : <span class="muted">{p.fatherUnknown ? 'neuveden' : 'zatím neznámý'}</span>} ·
              Matka: {p.mother ? <a href={`#${p.mother}`}>{people[p.mother].name}</a> : <span class="muted">zatím neznámá</span>}
            </p>
            {p.note && <p class="note small">{p.note}</p>}
            {p.side.length > 0 && <p class="small"><b>Příbuzní:</b> {p.side.map((s) => `${s.name} – ${s.text}`).join(' · ')}</p>}
            {rs.length > 0 && <div class="recs">{rs.map((r) => <Record id={r} open />)}</div>}
          </article>
        );
      })}
    </section>
  ))}
</Base>
<script is:inline>document.querySelectorAll('img[loading=lazy]').forEach((i) => (i.loading = 'eager'));</script>
<style>
  .kn-cover { text-align: center; }
  .kn-cover h1 { font-size: 3rem; margin-top: .5rem; }
  .kn-cover .lead { margin: 0 auto 1rem; }
  .kn-tree { max-width: 1100px; margin: 0 auto; }
  .kn-tree :global(.strom) { min-width: 0; }
  .kn-tree :global(.strom-legend) { justify-content: center; }
  .kn-toc li { margin: .3rem 0; }
  .kn-person { border-top: 1px solid var(--line); padding: 1rem 0 .6rem; }
  .kn-person h3, section > h2 { break-after: avoid; }
  .kn-person h3 { margin: 0 0 .3rem; font-size: 1.35rem; }
  .kn-k { display: inline-grid; place-items: center; min-width: 2rem; height: 2rem; padding: 0 .3rem; border-radius: 50%; background: var(--wood); color: var(--gold-light); font-size: .85rem; border: 2px solid var(--gold); vertical-align: middle; }
  .kn-person .recs { margin-top: .6rem; }
  @media print {
    .kn-cover h1 { margin-top: 30mm; }
    .kn-tree :global(.strom-wrap) { box-shadow: none; }
    .kn-tree :global(.strom-legend) { display: none; }
    .kn-person .rec { break-inside: avoid; }
    .kn-person .rec img { max-height: 120mm; width: auto; max-width: 100%; }
  }
</style>
