---
import Base from '../layouts/Base.astro';
import FamilyMap from '../components/VintageMap.astro';
---
<Base title="Mapa rodu" wide>
  <h1>Kde žili naši předci</h1>
  <p class="lead">Každá tečka je jedna obec, barva podle rodu, velikost podle počtu předků. Najetím myší uvidíte jména, kliknutím přeskočíte na kartu obce pod mapou.</p>
  <FamilyMap height="calc(100vh - 230px)" />
  <p class="small muted">Polohy obcí jsou přibližné (střed dnešní obce).</p>
</Base>
